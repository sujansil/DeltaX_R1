APP_NAME=LeaderBoard Puzzles - Round 1
ENVIRONMENT=development
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
DATABASE_URL=postgresql+asyncpg://round1:round1@localhost:5432/round1
REDIS_URL=redis://localhost:6379/0

# Reset is denied by default, including in development. See R1_FEATURE_REPORT.md
# for fresh disposable rehearsal setup. Never enable these on competition hosts.
R1_RESET_ENABLED=false
R1_RESET_DATABASE_NAME=
R1_REHEARSAL_TOKEN=

# Local filesystem for development. Replace StorageService for object storage in production.
MEDIA_ROOT=./media
MEDIA_PUBLIC_PREFIX=/media

ACCESS_TOKEN_MINUTES=720
ACTIVATION_TOKEN_HOURS=72
MAX_UPLOAD_BYTES=5242880
